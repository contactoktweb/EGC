# =====================================================================
#  ECG Construction — variables de entorno
#  Copia este archivo como .env.local y completa los valores.
#  En Vercel: Project → Settings → Environment Variables (los mismos nombres).
# =====================================================================

# URL pública del sitio (canonical, sitemap, hreflang, Open Graph). Sin "/" final.
NEXT_PUBLIC_SITE_URL=https://ecgconstructionwa.com

# ---------------------------------------------------------------------
#  SANITY (CMS) — solo hay que poner estas claves
#  1. Crea el proyecto en https://www.sanity.io/manage  → copia el Project ID
#  2. Dataset: "production"
#  Sin estas claves la web usa el contenido de respaldo de src/content.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Solo si el dataset es privado: token con rol "Viewer".
SANITY_API_READ_TOKEN=

# Secreto del webhook que actualiza la web al publicar en Sanity (cualquier texto largo y aleatorio).
SANITY_REVALIDATE_SECRET=

# Solo para abrir el Studio aparte con `npm run sanity:studio` (mismo Project ID y dataset).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- Formulario de contacto (etapa final: Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=ecgconstructionwa@gmail.com
CONTACT_FROM_EMAIL=
